# Copy to config.env (git-ignored) and edit. Every variable can also be set in the environment.

# Output root of the pipeline: <OUT_ROOT>/<lane>/daily/<box>/YYYY/MM/DD.nc (daily counts),
# <OUT_ROOT>/<lane>/<box>/YYYY/MM.nc and YYYY.nc (itf_agg.py), <a>-<b>.nc and <a>-<b>/MM.nc (itf_pool.py),
# <OUT_ROOT>/modis/index/YYYY/DDD.json (index_modis.py). The bundled data/ directory uses the same layout.
OUT_ROOT=./out

# Cloud_cci (lane cci): raw L3U files and the two cdo subsets read by itf_day.py
CCI_RAW=/path/to/cci/raw                  # YYYY/MM/<file>.nc from cci_download.sh
CCI_S1_ARCHIVE=/path/to/cci/select        # extensive/YYYY/MM/ and intensive/YYYY/MM/ from cci_select.sh

# CLARA-A3 level-2b (lane clara): CM SAF order delivery mirrored by clara_stage.sh
CLARA_MIRROR=/path/to/clara               # tars/ plus CMA/, CPH/, CTO/, CWP/ trees of YYYY/MM/<file>.nc
CLARA_NETRC=/path/to/.cmsaf_netrc         # mode-600 netrc with the CM SAF credentials (never inside the repo)
CLARA_ORDERS="CMA:<id> CPH:<id> CTO:<id> CWP:<id>"   # CM SAF WUI order numbers, one per product
CLARA_URL=https://cmsaf.dwd.de/data

# MODIS MYD06_L2 collection 6.1 (lanes modis, modis5): LAADS mirror written by modis_download.sh
MODIS_ARCHIVE=/path/to/modis              # YYYY/DDD/MYD06_L2/YYYY/DDD/MYD06_L2.*.hdf
# LAADS_TOKEN is read from the environment by modis_download.sh and is deliberately not stored here.

# Resources
PARALLEL=4            # concurrent days in run_itf.sh and concurrent transfers in the download scripts
MEM_GB_PER_TASK=4     # virtual memory cap per python/cdo process (ulimit -v)
REWRITE=FALSE         # TRUE recomputes existing outputs
